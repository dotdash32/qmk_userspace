#|
Infinity 60 keyboard config with advanced home-row-mods.
Converted from QMK JSON keymap (hrm2 pattern).

Key features:
- Advanced HRM with rapid typing support
- Home row mods (hrm2 pattern, rctl→cmd for Mac):
    A(ralt), S(cmd), D(layer-num), F(lsft), G(lalt)
    H(lalt), J(rsft), K(layer-num), L(cmd), ;(ralt)
- Bottom row mods:
    Z(lsft), X(cmd), C(lalt), V(cmd)
    M(cmd), ,(lalt), .(cmd), /(rsft)
- Layer tap on D/K (num layer) and Space (vim-nav layer)
- D+F chord / J+K chord: shift + num layer (for shifted numbers/symbols)
- Multiple function layers for navigation, numbers, symbols, and media
|#

(defcfg
  process-unmapped-keys yes
  tap-hold-require-prior-idle 50
  macos-dev-names-include (
      "Apple Internal Keyboard / Trackpad"
  )
)

(deflocalkeys-macos
  copy  133
  pste 135
  cut   137
)

(platform (linux)
  (defvar Cmod rctl)
)

(platform (macos)
  (defvar Cmod rmet)
)

(defvar
  tap-time 150
  hold-time 200

  left-hand-keys (
    q w e r t
    a s d f g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h j k l ;
    n m , . /
  )
)


;; Override shift+space to produce underscore
;; But exclude this behavior when ctrl, cmd, or alt are held
(defoverridesv2
  (lsft spc) (lsft -) (lctl rctl lmet rmet lalt ralt) ()
  (rsft spc) (rsft -) (lctl rctl lmet rmet lalt ralt) ()
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lalt lmet           spc            rmet ralt
)

(deffakekeys
  to-base (layer-switch base)
)

(defalias
  ;; Auto-disable mods on rapid typing
  tap (multi
    (layer-switch nomods)
    (on-idle-fakekey to-base tap 20)
  )

  ;; compound/complicated chords
  HdExp (tap-hold $tap-time $hold-time d (layer-while-held num))
  HkExp (tap-hold $tap-time $hold-time k (layer-while-held num))
  HfExp (tap-hold-release-keys $tap-time $hold-time (multi f @tap) lsft $left-hand-keys)
  HjExp (tap-hold-release-keys $tap-time $hold-time (multi j @tap) rsft $right-hand-keys)
)

(defchords
  num_toggle_pre 50
  (d      ) @HdExp
  (  f    ) @HfExp
  (    j  ) @HjExp
  (      k) @HkExp
  (d f    ) (multi lsft (layer-while-held num))
  (    j k) (multi rsft (layer-while-held num))
  (d    k ) (layer-switch num)
)

(defchords
  num_toggle_on 50
  (3  ) 3
  (  8) 8
  (3 8) (layer-switch base) ;; return to base
)

(defalias
  CAP (caps-word 2000)

  ;; Grave escape (Esc normally, grave when shifted)
  gesc (tap-hold $tap-time $hold-time esc grv)

  ;; Layer toggles and momentary
  LsN (layer-while-held simple-nav)
  Lmd (layer-while-held media)
  LapN (layer-switch num)

  ;; Left hand home row mods (hrm2, rctl→cmd)
  HCl (tap-hold $tap-time $hold-time esc $Cmod)
  Ha (tap-hold-release-keys $tap-time $hold-time (multi a @tap) ralt   $left-hand-keys)
  Hs (tap-hold-release-keys $tap-time $hold-time (multi s @tap) $Cmod  $left-hand-keys)
  HdC (chord num_toggle_pre d)
  HfC (chord num_toggle_pre f)
  Hg (tap-hold-release-keys $tap-time $hold-time (multi g @tap) lalt   $left-hand-keys)

  ;; Right hand home row mods (hrm2, rctl→cmd)
  Hh  (tap-hold-release-keys $tap-time $hold-time (multi h @tap) lalt  $right-hand-keys)
  HjC  (chord num_toggle_pre j)
  HkC  (chord num_toggle_pre k)
  Hl  (tap-hold-release-keys $tap-time $hold-time (multi l @tap) $Cmod $right-hand-keys)
  Hsc (tap-hold-release-keys $tap-time $hold-time (multi ; @tap) ralt  $right-hand-keys)

  ;; Bottom row mods (hrm2, always shift, ctrl, alt, gui)
  Hz  (tap-hold-release-keys $tap-time $hold-time (multi z @tap) lsft  $left-hand-keys)
  Hx  (tap-hold-release-keys $tap-time $hold-time (multi x @tap) lctl  $left-hand-keys)
  Hc  (tap-hold-release-keys $tap-time $hold-time (multi c @tap) lalt  $left-hand-keys)
  Hv  (tap-hold-release-keys $tap-time $hold-time (multi v @tap) lmet  $left-hand-keys)
  Hm  (tap-hold-release-keys $tap-time $hold-time (multi m @tap) lmet  $right-hand-keys)
  Hco (tap-hold-release-keys $tap-time $hold-time (multi , @tap) lalt  $right-hand-keys)
  Hdo (tap-hold-release-keys $tap-time $hold-time (multi . @tap) rctl  $right-hand-keys)
  Hsl (tap-hold-release-keys $tap-time $hold-time (multi / @tap) rsft  $right-hand-keys)

  ;; Space as vim-nav layer tap-hold
  ;; Note: shift+space -> underscore is handled by defoverridesv2
  spcNav (tap-hold $tap-time $hold-time spc (layer-while-held vim-nav))

  ;; Number layer home row mods (hrm2, rctl→cmd)
  HaN  (tap-hold-release-keys $tap-time $hold-time 1    ralt  $left-hand-keys)
  HsN  (tap-hold-release-keys $tap-time $hold-time 2    $Cmod $left-hand-keys)
  ;; d is already layer-tap (num), acts as 3 on this layer
  HdN (chord num_toggle_on 3)
  HfN  (tap-hold-release-keys $tap-time $hold-time 4    lsft  $left-hand-keys)
  HgN  (tap-hold-release-keys $tap-time $hold-time 5    lalt  $left-hand-keys)
  HhN  (tap-hold-release-keys $tap-time $hold-time 6    lalt  $right-hand-keys)
  HjN  (tap-hold-release-keys $tap-time $hold-time 7    rsft  $right-hand-keys)
  ;; k is already layer-tap (num), acts as 8 on this layer
  HkN  (chord num_toggle_on 8)
  HlN  (tap-hold-release-keys $tap-time $hold-time 9     $Cmod $right-hand-keys)
  HscN (tap-hold-release-keys $tap-time $hold-time 0     ralt $right-hand-keys)

  ;; Number layer bottom row mods (hrm2, rctl→cmd)
  HzN  (tap-hold-release-keys $tap-time $hold-time grv   lsft $left-hand-keys)
  HxN  (tap-hold-release-keys $tap-time $hold-time cut   lctl $left-hand-keys)
  HcN  (tap-hold-release-keys $tap-time $hold-time copy  lalt $left-hand-keys)
  HvN  (tap-hold-release-keys $tap-time $hold-time pste  lmet $left-hand-keys)
  HmN  (tap-hold-release-keys $tap-time $hold-time 0     lmet $right-hand-keys)
  HcoN (tap-hold-release-keys $tap-time $hold-time ,     lalt $right-hand-keys)
  HdoN (tap-hold-release-keys $tap-time $hold-time .     lctl $right-hand-keys)
  HslN (tap-hold-release-keys $tap-time $hold-time ret   rsft $right-hand-keys)

  ;; Vim nav mods (hrm2, rctl→cmd)
  HaV  (tap-hold-release-keys $tap-time $hold-time (multi a     @tap) ralt  $left-hand-keys)
  HsV  (tap-hold-release-keys $tap-time $hold-time (multi s     @tap) $Cmod $left-hand-keys)
  HdV  (tap-hold              $tap-time $hold-time d                  (layer-while-held num))
  HfV  (tap-hold-release-keys $tap-time $hold-time (multi f     @tap) lsft  $left-hand-keys)
  HgV  (tap-hold-release-keys $tap-time $hold-time (multi tab   @tap) lalt  $left-hand-keys)
  HzV  (tap-hold-release-keys $tap-time $hold-time (multi z     @tap) lsft  $left-hand-keys)
  HxV  (tap-hold-release-keys $tap-time $hold-time (multi x     @tap) lmet  $left-hand-keys)
  HcV  (tap-hold-release-keys $tap-time $hold-time (multi c     @tap) lalt  $left-hand-keys)
  HvV  (tap-hold-release-keys $tap-time $hold-time (multi v     @tap) lmet  $left-hand-keys)

  HhV  (tap-hold-release-keys $tap-time $hold-time left  lalt $right-hand-keys)
  HjV  (tap-hold-release-keys $tap-time $hold-time down  rsft $right-hand-keys)
  HkV  (tap-hold              $tap-time $hold-time up    (layer-while-held num))
  HlV  (tap-hold-release-keys $tap-time $hold-time right $Cmod $right-hand-keys)
  HscV (tap-hold-release-keys $tap-time $hold-time (multi '     @tap) ralt $right-hand-keys)
  HmV  (tap-hold-release-keys $tap-time $hold-time (multi spc   @tap) lmet $right-hand-keys)
  HcoV (tap-hold-release-keys $tap-time $hold-time (multi ]     @tap) lalt $right-hand-keys)
  HdoV (tap-hold-release-keys $tap-time $hold-time (multi .     @tap) rctl $right-hand-keys)
  HslV (tap-hold-release-keys $tap-time $hold-time (multi ret   @tap) rsft $right-hand-keys)
)

(deflayer base
  grv   1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab   q    w    e    r    t    y    u    i    o    p    [    ]    \
  @HCl  @Ha  @Hs  @HdC @HfC @Hg  @Hh  @HjC @HkC @Hl  @Hsc '    ret
  lsft  @Hz  @Hx  @Hc  @Hv  b    n    @Hm  @Hco @Hdo @Hsl rsft
  lctl  lalt lmet           @spcNav        rmet @LsN
)

(deflayer nomods
  grv   1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab   q    w    e    r    t    y    u    i    o    p    [    ]    \
  $Cmod a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft  z    x    c    v    b    n    m    ,    .    /    rsft
  lctl  lalt lmet           spc             rmet _
)

(deflayer simple-nav
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  _
  _    _    _    _    _    _    _    _    pgup home up   end  del  _
  _    _    _    _    _    _    _    _    pgdn left down rght ret
  _    _    _    _    _    _    _    _    [    ]    _    _
  _    _    _              _              _    _
)

(deflayer num
  _    _    _    _    _    _    _    _    _     _     _     _     _    _
  _    q    bspc del  esc  lrld _    -    =     \     grv   _     _    _
  _    @HaN @HsN @HdN @HfN @HgN @HhN @HjN @HkN  @HlN  @HscN @LapN _
  _    @HzN @HxN @HcN @HvN @CAP \    @HmN @HcoN @HdoN @HslN _
  _    _    _              _              _    _
)

(deflayer vim-nav
  _    _    _    _    _    _    _    _    _     _     _     _    _    _
  _    q    bspc del  esc  C-spc home pgdn pgup  end   _     _    _    _
  _    @HaV @HsV @HdV @HfV @HgV @HhV @HjV @HkV  @HlV  @HscV ralt _
  _    @HzV @HxV @HcV @HvV C-b  [    @HmV @HcoV @HdoV @HslV _
  _    _    _              _              _     _
)

(deflayer media
  _    _    _    _     _    _    _    _    _    _    _    _    _    _
  _    _    pgdn up    pgup t    _    _    _    _    volu _    _    _
  _    _    left down  rght bck  _    _    _    _    vold _    _
  _    _    cut  copy  pste fwd  _    _    prev next pp   _
  _    _    _              _              _    _
)

#|
Infinity 60 keyboard config with advanced home-row-mods.
Converted from QMK JSON keymap (hrm2 pattern).

Key features:
- Advanced HRM with rapid typing support
- Home row mods (hrm2 pattern, rctl→cmd for Mac):
    A(ralt), S(cmd), D(layer-num), F(lsft), G(lalt)
    H(lalt), J(rsft), K(layer-num), L(cmd), ;(ralt)
- Bottom row mods:
    Z(lsft), X(cmd), C(lalt), V(cmd)
    M(cmd), ,(lalt), .(cmd), /(rsft)
- Layer tap on D/K (num layer) and Space (vim-nav layer)
- Multiple function layers for navigation, numbers, symbols, and media
|#

(defcfg
  process-unmapped-keys yes
  tap-hold-require-prior-idle 50
)

(defvar
  tap-time 150
  hold-time 200

  left-hand-keys (
    q w e r t
    a s d f g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h j k l ;
    n m , . /
  )
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lalt lmet           spc            rmet ralt
)

(deffakekeys
  to-base (layer-switch base)
)

(defchords
  dk 50
  (d  ) @Hd
  (  k) @Hk
  (d k) (layer-toggle num)
)

(defchords
  38 50
  (3  ) 3
  (  8) 8
  (3 8 ) (layer-toggle num)
)

(defalias
  ;; Auto-disable mods on rapid typing
  tap (multi
    (layer-switch nomods)
    (on-idle-fakekey to-base tap 20)
  )

  CAP (caps-word 2000)

  ;; Grave escape (Esc normally, grave when shifted)
  gesc (tap-hold $tap-time $hold-time esc grv)

  ;; Layer toggles and momentary
  LsN (layer-while-held simple-nav)
  Lmd (layer-while-held media)
  LapN (layer-tHrbVoggle num)

  ;; Left hand home row mods (hrm2, rctl→cmd)
  Ha (tap-hold-release-keys $tap-time $hold-time (multi a @tap) ralt $left-hand-keys)
  Hs (tap-hold-release-keys $tap-time $hold-time (multi s @tap) rmet $left-hand-keys)
  Hd (tap-hold $tap-time $hold-time d (layer-while-held num))
  Hf (tap-hold-release-keys $tap-time $hold-time (multi f @tap) lsft $left-hand-keys)
  Hg (tap-hold-release-keys $tap-time $hold-time (multi g @tap) lalt $left-hand-keys)

  ;; Right hand home row mods (hrm2, rctl→cmd)
  Hh (tap-hold-release-keys $tap-time $hold-time (multi h @tap) lalt $right-hand-keys)
  Hj (tap-hold-release-keys $tap-time $hold-time (multi j @tap) rsft $right-hand-keys)
  Hk (tap-hold $tap-time $hold-time k (layer-while-held num))
  Hl (tap-hold-release-keys $tap-time $hold-time (multi l @tap) rmet $right-hand-keys)
  Hsc (tap-hold-release-keys $tap-time $hold-time (multi ; @tap) ralt $right-hand-keys)

  ;; Bottom row mods (hrm2, rctl→cmd)
  Hz (tap-hold-release-keys $tap-time $hold-time (multi z @tap) lsft $left-hand-keys)
  Hx (tap-hold-release-keys $tap-time $hold-time (multi x @tap) lmet $left-hand-keys)
  Hc (tap-hold-release-keys $tap-time $hold-time (multi c @tap) lalt $left-hand-keys)
  Hv (tap-hold-release-keys $tap-time $hold-time (multi v @tap) lmet $left-hand-keys)
  Hm (tap-hold-release-keys $tap-time $hold-time (multi m @tap) rmet $right-hand-keys)
  Hco (tap-hold-release-keys $tap-time $hold-time (multi , @tap) lalt $right-hand-keys)
  Hdo (tap-hold-release-keys $tap-time $hold-time (multi . @tap) rmet $right-hand-keys)
  Hsl (tap-hold-release-keys $tap-time $hold-time (multi / @tap) rsft $right-hand-keys)

  ;; Space as vim-nav layer tap-hold
  spcNav (tap-hold $tap-time $hold-time spc (layer-while-held vim-nav))

  ;; Number layer home row mods (hrm2, rctl→cmd)
  HaN (tap-hold-release-keys $tap-time $hold-time (multi 1 @tap) ralt $left-hand-keys)
  HsN (tap-hold-release-keys $tap-time $hold-time (multi 2 @tap) rmet $left-hand-keys)
  ;; d is already layer-tap (num), acts as 3 on this layer
  HfN (tap-hold-release-keys $tap-time $hold-time (multi 4 @tap) lsft $left-hand-keys)
  HgN (tap-hold-release-keys $tap-time $hold-time (multi 5 @tap) lalt $left-hand-keys)
  HhN (tap-hold-release-keys $tap-time $hold-time (multi 6 @tap) lalt $right-hand-keys)
  HjN (tap-hold-release-keys $tap-time $hold-time (multi 7 @tap) rsft $right-hand-keys)
  ;; k is already layer-tap (num), acts as 8 on this layer
  HlN (tap-hold-release-keys $tap-time $hold-time (multi 9 @tap) rmet $right-hand-keys)
  HscN (tap-hold-release-keys $tap-time $hold-time (multi ' @tap) ralt $right-hand-keys)

  ;; Number layer bottom row mods (hrm2, rctl→cmd)
  HzN (tap-hold-release-keys $tap-time $hold-time (multi grv @tap) lsft $left-hand-keys)
  HxN (tap-hold-release-keys $tap-time $hold-time (multi S-x @tap) lmet $left-hand-keys)
  HcN (tap-hold-release-keys $tap-time $hold-time (multi S-c @tap) lalt $left-hand-keys)
  HvN (tap-hold-release-keys $tap-time $hold-time (multi S-v @tap) lmet $left-hand-keys)
  HmN (tap-hold-release-keys $tap-time $hold-time (multi 0 @tap) rmet $right-hand-keys)
  HcoN (tap-hold-release-keys $tap-time $hold-time (multi , @tap) lalt $right-hand-keys)
  HdoN (tap-hold-release-keys $tap-time $hold-time (multi . @tap) rmet $right-hand-keys)
  HslN (tap-hold-release-keys $tap-time $hold-time (multi ret @tap) rsft $right-hand-keys)

  ;; Vim nav mods (hrm2, rctl→cmd)
  HaV (tap-hold-release-keys $tap-time $hold-time (multi a @tap) ralt $left-hand-keys)
  HsV (tap-hold-release-keys $tap-time $hold-time (multi s @tap) rmet $left-hand-keys)
  HdV (tap-hold $tap-time $hold-time d (layer-while-held num))
  HfV (tap-hold-release-keys $tap-time $hold-time (multi f @tap) lsft $left-hand-keys)
  HgV (tap-hold-release-keys $tap-time $hold-time (multi tab @tap) lalt $left-hand-keys)
  HzV (tap-hold-release-keys $tap-time $hold-time (multi z @tap) lsft $left-hand-keys)
  HxV (tap-hold-release-keys $tap-time $hold-time (multi x @tap) lmet $left-hand-keys)
  HcV (tap-hold-release-keys $tap-time $hold-time (multi c @tap) lalt $left-hand-keys)
  HvV (tap-hold-release-keys $tap-time $hold-time (multi v @tap) lmet $left-hand-keys)

  HhV (tap-hold-release-keys $tap-time $hold-time (multi left @tap) lalt $right-hand-keys)
  HjV (tap-hold-release-keys $tap-time $hold-time (multi down @tap) rsft $right-hand-keys)
  HkV (tap-hold $tap-time $hold-time up (layer-while-held num))
  HlV (tap-hold-release-keys $tap-time $hold-time (multi right @tap) rmet $right-hand-keys)
  HscV (tap-hold-release-keys $tap-time $hold-time (multi ' @tap) ralt $right-hand-keys)
  HmV (tap-hold-release-keys $tap-time $hold-time (multi spc @tap) rmet $right-hand-keys)
  HcoV (tap-hold-release-keys $tap-time $hold-time (multi ] @tap) lalt $right-hand-keys)
  HdoV (tap-hold-release-keys $tap-time $hold-time (multi . @tap) rmet $right-hand-keys)
  HentV (tap-hold-release-keys $tap-time $hold-time (multi ret @tap) rsft $right-hand-keys)
)

(deflayer base
  grv   1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab   q    w    e    r    t    y    u    i    o    p    [    ]    \
  lmet  @Ha  @Hs  @Hd  @Hf  @Hg  @Hh  @Hj  @Hk  @Hl  @Hsc '    ret
  lsft  @Hz  @Hx  @Hc  @Hv  b    n    @Hm  @Hco @Hdo @Hsl rsft
  lctl  lalt lmet           @spcNav        rmet @LsN
)

(deflayer nomods
  grv   1    2    3    4    5    6    7    8    9    0    -    =    \
  tab   q    w    e    r    t    y    u    i    o    p    [    ]    bspc
  lctl  a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft  z    x    c    v    b    n    m    ,    .    /    rsft
  lctl  lalt lmet           spc             rmet _
)

(deflayer simple-nav
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  _
  _    _    _    _    _    _    _    _    pgup home up   end  del  _
  _    _    _    _    _    _    _    _    pgdn left down rght ret
  _    _    _    _    _    _    _    _    [    ]    _    _
  _    _    _              _              _    _
)

(deflayer num
  _    _    _    _    _    _    _    _    _     _     _     _     _    _
  _    q    bspc del  esc  @CAP _    -    =     \     grv   _     _    _
  _    @HaN @HsN 3    @HfN @HgN @HhN @HjN 8     @HlN  @HscN @LapN _
  _    @HzN @HxN @HcN @HvN @CAP \    @HmN @HcoN @HdoN @HslN _
  _    _    _              _              _    _
)

(deflayer vim-nav
  _    _    _    _    _    _    _    _    _     _     _     _    _    _
  _    q    bspc del  esc  t    home pgdn pgup  end   _     _    _    _
  _    @HaV @HsV @HdV @HfV @HgV @HhV @HjV @HkV  @HlV  @HscV ralt _
  _    @HzV @HxV @HcV @HvV _    [    @HmV @HcoV @HdoV @HentV _
  _    _    _              _              _     _
)

(deflayer media
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    pgdn up   pgup t    _    _    _    _    volu _    _    _
  _    _    left down rght M-[  _    _    _    _    vold _    _
  _    _    M-x  M-c  M-v  M-]  _    _    prev next pp   _
  _    _    _              _              _    _
)
